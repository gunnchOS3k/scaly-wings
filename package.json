{
  "name": "scaly-wings",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check": "node scripts/check-project-health.js",
    "i18n:check": "node scripts/check-localization.js",
    "expo:go": "npx expo start",
    "expo:go:tunnel": "npx expo start --tunnel",
    "expo:web": "npx expo start --web",
    "android:dev": "npx expo run:android",
    "android:uninstall": "adb uninstall com.gunnchos3k.scalywings",
    "android:devices": "adb devices",
    "eas:login": "eas login",
    "eas:configure": "eas build:configure",
    "android:apk": "eas build -p android --profile preview-apk",
    "android:aab": "eas build -p android --profile production-android",
    "ios:register-devices": "eas device:create",
    "ios:devices": "eas device:list",
    "ios:internal": "eas build -p ios --profile preview-ios",
    "ios:testflight-build": "eas build -p ios --profile production-ios",
    "ios:submit": "eas submit -p ios --profile production-ios",
    "build:all-preview": "npm run android:apk && npm run ios:internal",
    "mobile:menu": "bash scripts/scaly-wings-mobile-build-menu.sh",
    "pixel6a:apk-flow": "bash scripts/scaly-wings-pixel6a-release-flow.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "^56.0.6",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
